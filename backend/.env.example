# Copy this file to backend/.env
# Start the API from the backend/ directory so pydantic-settings finds .env.
#
# The app reads DATABASE_URL. The "+psycopg" part is the SQLAlchemy driver.
# psql does not accept that form. For psql, drop "+psycopg":
#   postgresql://app_user:local_dev_password@127.0.0.1:5432/app_db

DATABASE_URL=postgresql+psycopg://Neon用戶:Neon密碼@Neon主機/fake_bank?sslmode=require
JWT_SECRET=fake_bank_jwt_secret
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENROUTER_API_KEY=sk-proj-1234567890